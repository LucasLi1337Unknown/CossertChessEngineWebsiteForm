ELLO "GENERATEPIECEMOVES" YOUR NOW DOIN {
    HMM WATIF(piece == "wP")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETN()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(targetPiece == "")
            GET "wpOne" LETITB ADDLEGAL()
            "mapIndex" CHANGETO-> moveFrom
            "rowValue" CHANGETO-> GETROW()
            HMM WATIF(rowValue == 6)
                "mapIndex" CHANGETO-> moveTo
                GET "wpTwoSq" LETITB GETN()
                "readIndex" CHANGETO-> wpTwoSq
                GET "wpTwoPiece" LETITB READCELL()
                HMM WATIF(wpTwoPiece == "")
                    "moveTo" CHANGETO-> wpTwoSq
                    GET "wpTwo" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETNW()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(NO{targetPiece == ""})
            GET "wpCap" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETNE()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(NO{targetPiece == ""})
            GET "wpCap" LETITB ADDLEGAL()
        FINALANSER(0)
    HMM WATIF(piece == "bP")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETS()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(targetPiece == "")
