ELLO "SIMULATEMOVE" YOUR NOW DOIN {
    "simFrom" CHANGETO-> moveFrom
    "simTo" CHANGETO-> moveTo
    "readIndex" CHANGETO-> simFrom
    "savedFromPiece" CHANGETO-> READCELL()
    "readIndex" CHANGETO-> simTo
    "savedToPiece" CHANGETO-> READCELL()
    UREPLACEIT{board}[simFrom] W/""
    UREPLACEIT{board}[simTo] W/savedFromPiece
    "mapIndex" CHANGETO-> simTo
    "rowValue" CHANGETO-> GETROW()
    HMM WATIF(savedFromPiece == "wP")
        HMM WATIF(rowValue == 0)
            UREPLACEIT{board}[simTo] W/"wQ"
    HMM WATIF(savedFromPiece == "bP")
        HMM WATIF(rowValue == 7)
            UREPLACEIT{board}[simTo] W/"bQ"
    FINALANSER(0)
}

ELLO "UNDOMOVE" YOUR NOW DOIN {
    UREPLACEIT{board}[simFrom] W/savedFromPiece
    UREPLACEIT{board}[simTo] W/savedToPiece
    FINALANSER(0)
}

ELLO "DOMOVE" YOUR NOW DOIN {
    "readIndex" CHANGETO-> moveFrom
    GET "realPiece" LETITB READCELL()
    UREPLACEIT{board}[moveFrom] W/""
    UREPLACEIT{board}[moveTo] W/realPiece
    "mapIndex" CHANGETO-> moveTo
    "rowValue" CHANGETO-> GETROW()
    HMM WATIF(realPiece == "wP")
        HMM WATIF(rowValue == 0)
            UREPLACEIT{board}[moveTo] W/"wQ"
    HMM WATIF(realPiece == "bP")
        HMM WATIF(rowValue == 7)
            UREPLACEIT{board}[moveTo] W/"bQ"
    FINALANSER(0)
}

ELLO "RAYATTACK" YOUR NOW DOIN {
    "raySq" CHANGETO-> attackFrom
    GOAROUND 7 TIMES:
        "mapIndex" CHANGETO-> raySq
        HMM WATIF(rayDir == 0)
            "rayNext" CHANGETO-> GETN()
        HMM WATIF(rayDir == 1)
            "rayNext" CHANGETO-> GETS()
        HMM WATIF(rayDir == 2)
            "rayNext" CHANGETO-> GETE()
        HMM WATIF(rayDir == 3)
            "rayNext" CHANGETO-> GETW()
        HMM WATIF(rayDir == 4)
            "rayNext" CHANGETO-> GETNE()
        HMM WATIF(rayDir == 5)
            "rayNext" CHANGETO-> GETNW()
        HMM WATIF(rayDir == 6)
            "rayNext" CHANGETO-> GETSE()
        HMM WATIF(rayDir == 7)
            "rayNext" CHANGETO-> GETSW()
        HMM WATIF(rayNext == -1)
            FINALANSER(0)
        HMM WATIF(rayNext == kingSq)
            FINALANSER(1)
        "readIndex" CHANGETO-> rayNext
        "rayPiece" CHANGETO-> READCELL()
        HMM WATIF(NO{rayPiece == ""})
            FINALANSER(0)
        "raySq" CHANGETO-> rayNext
    FINALANSER(0)
}

ELLO "ATTACKSKING" YOUR NOW DOIN {
    HMM WATIF(attackPiece == "wP")
        "mapIndex" CHANGETO-> attackFrom
        GET "pAtkwPNW" LETITB GETNW()
        HMM WATIF(pAtkwPNW == kingSq)
            FINALANSER(1)
        "mapIndex" CHANGETO-> attackFrom
