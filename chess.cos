        HMM WATIF(nAtkwN8 == kingSq)
            FINALANSER(1)
    HMM WATIF(attackPiece == "bN")
        "mapIndex" CHANGETO-> attackFrom
        GET "nAtkbN1" LETITB GETK1()
        HMM WATIF(nAtkbN1 == kingSq)
            FINALANSER(1)
        "mapIndex" CHANGETO-> attackFrom
        GET "nAtkbN2" LETITB GETK2()
        HMM WATIF(nAtkbN2 == kingSq)
            FINALANSER(1)
        "mapIndex" CHANGETO-> attackFrom
        GET "nAtkbN3" LETITB GETK3()
        HMM WATIF(nAtkbN3 == kingSq)
            FINALANSER(1)
