                "mapIndex" CHANGETO-> moveTo
                GET "bpTwoSq" LETITB GETS()
                "readIndex" CHANGETO-> bpTwoSq
                GET "bpTwoPiece" LETITB READCELL()
                HMM WATIF(bpTwoPiece == "")
                    "moveTo" CHANGETO-> bpTwoSq
                    GET "bpTwo" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSW()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(NO{targetPiece == ""})
            GET "bpCap" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSE()
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        HMM WATIF(NO{targetPiece == ""})
            GET "bpCap" LETITB ADDLEGAL()
        FINALANSER(0)
    HMM WATIF(piece == "wN")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK1()
        GET "knwN1" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK2()
        GET "knwN2" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK3()
        GET "knwN3" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK4()
        GET "knwN4" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK5()
        GET "knwN5" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK6()
        GET "knwN6" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK7()
        GET "knwN7" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK8()
        GET "knwN8" LETITB ADDLEGAL()
        FINALANSER(0)
    HMM WATIF(piece == "bN")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK1()
        GET "knbN1" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK2()
        GET "knbN2" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK3()
        GET "knbN3" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK4()
        GET "knbN4" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK5()
        GET "knbN5" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK6()
        GET "knbN6" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK7()
        GET "knbN7" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETK8()
        GET "knbN8" LETITB ADDLEGAL()
        FINALANSER(0)
    HMM WATIF(piece == "wB")
        GET "slidewBNE" LETITB MOVESNE()
        GET "slidewBNW" LETITB MOVESNW()
        GET "slidewBSE" LETITB MOVESSE()
        GET "slidewBSW" LETITB MOVESSW()
        FINALANSER(0)
    HMM WATIF(piece == "bB")
        GET "slidebBNE" LETITB MOVESNE()
        GET "slidebBNW" LETITB MOVESNW()
        GET "slidebBSE" LETITB MOVESSE()
        GET "slidebBSW" LETITB MOVESSW()
        FINALANSER(0)
    HMM WATIF(piece == "wR")
        GET "slidewRN" LETITB MOVESN()
        GET "slidewRS" LETITB MOVESS()
        GET "slidewRE" LETITB MOVESE()
        GET "slidewRW" LETITB MOVESW()
        FINALANSER(0)
    HMM WATIF(piece == "bR")
