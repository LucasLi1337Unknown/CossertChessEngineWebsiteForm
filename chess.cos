        GET "slidebQNW" LETITB MOVESNW()
        GET "slidebQSE" LETITB MOVESSE()
        GET "slidebQSW" LETITB MOVESSW()
        FINALANSER(0)
    HMM WATIF(piece == "wK")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETN()
        GET "kingMovewKN" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETS()
        GET "kingMovewKS" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETE()
        GET "kingMovewKE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETW()
        GET "kingMovewKW" LETITB ADDLEGAL()
