        GET "kingMovewKNE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETNW()
        GET "kingMovewKNW" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSE()
        GET "kingMovewKSE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSW()
        GET "kingMovewKSW" LETITB ADDLEGAL()
        FINALANSER(0)
    HMM WATIF(piece == "bK")
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETN()
        GET "kingMovebKN" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETS()
        GET "kingMovebKS" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETE()
        GET "kingMovebKE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETW()
        GET "kingMovebKW" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETNE()
        GET "kingMovebKNE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETNW()
        GET "kingMovebKNW" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSE()
        GET "kingMovebKSE" LETITB ADDLEGAL()
        "mapIndex" CHANGETO-> moveFrom
        "moveTo" CHANGETO-> GETSW()
        GET "kingMovebKSW" LETITB ADDLEGAL()
        FINALANSER(0)
    FINALANSER(0)
}

ELLO "GENERATELEGAL" YOUR NOW DOIN {
    HAV A LIST "fromMoves" LIKE []:
    HAV A LIST "toMoves" LIKE []:
    "moveCount" CHANGETO-> 0
    "genSq" CHANGETO-> 0
    GOAROUND 64 TIMES:
        "readIndex" CHANGETO-> genSq
        "piece" CHANGETO-> READCELL()
        GET "owns" LETITB ISCURRENTPIECE()
        HMM WATIF(owns == 1)
            "moveFrom" CHANGETO-> genSq
            GET "onePieceMoves" LETITB GENERATEPIECEMOVES()
        "genSq" CHANGETO-> YO COMBINE genSq W/1
    FINALANSER(moveCount)
}

ELLO "EVALUATE" YOUR NOW DOIN {
    "evalScore" CHANGETO-> 0
    "evalSq" CHANGETO-> 0
    GOAROUND 64 TIMES:
        "readIndex" CHANGETO-> evalSq
        "piece" CHANGETO-> READCELL()
        HMM WATIF(piece == "bP")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/100
        HMM WATIF(piece == "bN")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/320
        HMM WATIF(piece == "bB")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/330
        HMM WATIF(piece == "bR")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/500
        HMM WATIF(piece == "bQ")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/900
        HMM WATIF(piece == "bK")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/0
        HMM WATIF(piece == "wP")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/-100
        HMM WATIF(piece == "wN")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/-320
        HMM WATIF(piece == "wB")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/-330
        HMM WATIF(piece == "wR")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/-500
        HMM WATIF(piece == "wQ")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/-900
        HMM WATIF(piece == "wK")
            "evalScore" CHANGETO-> YO COMBINE evalScore W/0
        "evalSq" CHANGETO-> YO COMBINE evalSq W/1
    FINALANSER(evalScore)
}

