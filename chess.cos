ELLO "GETN" YOUR NOW DOIN {
    HMM WATIF(mapIndex < 0)
        FINALANSER(-1)
    HMM WATIF(mapIndex > 63)
        FINALANSER(-1)
    GET "mapNValue" LETITB TAKITOUT{NMAP}[mapIndex]
    UREPLACEIT{NMAP}[mapIndex] W/mapNValue
    FINALANSER(mapNValue)
}

