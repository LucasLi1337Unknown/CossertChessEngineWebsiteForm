    GET "r5p5" LETITB YO COMBINE r5sp4 W/s45
    GET "r5sp5" LETITB YO COMBINE r5p5 W/" "
    GET "r5p6" LETITB YO COMBINE r5sp5 W/s46
    GET "r5sp6" LETITB YO COMBINE r5p6 W/" "
    GET "r5p7" LETITB YO COMBINE r5sp6 W/s47
    GET "rank5" LETITB YO COMBINE "3  " W/r5p7
    GET "r6a" LETITB YO COMBINE s48 W/" "
    GET "r6p1" LETITB YO COMBINE r6a W/s49
    GET "r6sp1" LETITB YO COMBINE r6p1 W/" "
    GET "r6p2" LETITB YO COMBINE r6sp1 W/s50
    GET "r6sp2" LETITB YO COMBINE r6p2 W/" "
    GET "r6p3" LETITB YO COMBINE r6sp2 W/s51
    GET "r6sp3" LETITB YO COMBINE r6p3 W/" "
    GET "r6p4" LETITB YO COMBINE r6sp3 W/s52
    GET "r6sp4" LETITB YO COMBINE r6p4 W/" "
    GET "r6p5" LETITB YO COMBINE r6sp4 W/s53
    GET "r6sp5" LETITB YO COMBINE r6p5 W/" "
    GET "r6p6" LETITB YO COMBINE r6sp5 W/s54
    GET "r6sp6" LETITB YO COMBINE r6p6 W/" "
    GET "r6p7" LETITB YO COMBINE r6sp6 W/s55
    GET "rank6" LETITB YO COMBINE "2  " W/r6p7
    GET "r7a" LETITB YO COMBINE s56 W/" "
    GET "r7p1" LETITB YO COMBINE r7a W/s57
    GET "r7sp1" LETITB YO COMBINE r7p1 W/" "
    GET "r7p2" LETITB YO COMBINE r7sp1 W/s58
    GET "r7sp2" LETITB YO COMBINE r7p2 W/" "
    GET "r7p3" LETITB YO COMBINE r7sp2 W/s59
    GET "r7sp3" LETITB YO COMBINE r7p3 W/" "
    GET "r7p4" LETITB YO COMBINE r7sp3 W/s60
    GET "r7sp4" LETITB YO COMBINE r7p4 W/" "
    GET "r7p5" LETITB YO COMBINE r7sp4 W/s61
    GET "r7sp5" LETITB YO COMBINE r7p5 W/" "
    GET "r7p6" LETITB YO COMBINE r7sp5 W/s62
    GET "r7sp6" LETITB YO COMBINE r7p6 W/" "
    GET "r7p7" LETITB YO COMBINE r7sp6 W/s63
    GET "rank7" LETITB YO COMBINE "1  " W/r7p7
    SPITOUT("")
    SPITOUT(rank0)
    SPITOUT(rank1)
    SPITOUT(rank2)
    SPITOUT(rank3)
    SPITOUT(rank4)
    SPITOUT(rank5)
    SPITOUT(rank6)
    SPITOUT(rank7)
    SPITOUT("   A  B  C  D  E  F  G  H")
    SPITOUT("IDs: A8=0 H8=7 A1=56 H1=63")
    SPITOUT("")
    FINALANSER(0)
}

ELLO "HUMANMOVE" YOUR NOW DOIN {
    GOAROUND 100 TIMES:
        YO USER DILE("FROM square ID 0-63: "): humanFrom
        YO USER DILE("TO square ID 0-63: "): humanTo
        HMM WATIF(humanFrom < 0)
            SPITOUT("INVALID FROM.")
            SKIPTIS
        HMM WATIF(humanFrom > 63)
            SPITOUT("INVALID FROM.")
            SKIPTIS
        HMM WATIF(humanTo < 0)
            SPITOUT("INVALID TO.")
            SKIPTIS
        HMM WATIF(humanTo > 63)
            SPITOUT("INVALID TO.")
            SKIPTIS
        GET "generatedHuman" LETITB GENERATELEGAL()
        "validHuman" CHANGETO-> 0
        "listIndex" CHANGETO-> 0
        GOAROUND moveCount TIMES:
            GET "hf" LETITB TAKITOUT{fromMoves}[listIndex]
            UREPLACEIT{fromMoves}[listIndex] W/hf
            GET "ht" LETITB TAKITOUT{toMoves}[listIndex]
            UREPLACEIT{toMoves}[listIndex] W/ht
            HMM WATIF(hf == humanFrom)
                HMM WATIF(ht == humanTo)
                    "validHuman" CHANGETO-> 1
            "listIndex" CHANGETO-> YO COMBINE listIndex W/1
        HMM WATIF(validHuman == 1)
            "moveFrom" CHANGETO-> humanFrom
            "moveTo" CHANGETO-> humanTo
            GET "doneHuman" LETITB DOMOVE()
            FINALANSER(1)
        SPITOUT("ILLEGAL MOVE. TRY AGAIN.")
    FINALANSER(0)
}

ELLO "AIMOVE" YOUR NOW DOIN {
    "moveSide" CHANGETO-> "B"
    GET "genAI" LETITB GENERATELEGAL()
    "aiCount" CHANGETO-> moveCount
    HAV A LIST "aiFrom" LIKE []:
    HAV A LIST "aiTo" LIKE []:
    "listIndex" CHANGETO-> 0
    GOAROUND aiCount TIMES:
        GET "af" LETITB TAKITOUT{fromMoves}[listIndex]
        UREPLACEIT{fromMoves}[listIndex] W/af
        GET "at" LETITB TAKITOUT{toMoves}[listIndex]
        UREPLACEIT{toMoves}[listIndex] W/at
        GETDATIN{aiFrom} W/af
        GETDATIN{aiTo} W/at
        "listIndex" CHANGETO-> YO COMBINE listIndex W/1
    "bestScore" CHANGETO-> -999999
    "bestFrom" CHANGETO-> -1
    "bestTo" CHANGETO-> -1
    "aiIndex" CHANGETO-> 0
    GOAROUND aiCount TIMES:
        "candidateFrom" CHANGETO-> TAKITOUT{aiFrom}[aiIndex]
        UREPLACEIT{aiFrom}[aiIndex] W/candidateFrom
        "candidateTo" CHANGETO-> TAKITOUT{aiTo}[aiIndex]
        UREPLACEIT{aiTo}[aiIndex] W/candidateTo
        "moveFrom" CHANGETO-> candidateFrom
        "moveTo" CHANGETO-> candidateTo
        GET "simAI" LETITB SIMULATEMOVE()
        "tempScore" CHANGETO-> EVALUATE()
        GET "undoAI" LETITB UNDOMOVE()
        "moveSide" CHANGETO-> "B"
        HMM WATIF(tempScore > bestScore)
            "bestScore" CHANGETO-> tempScore
            "bestFrom" CHANGETO-> candidateFrom
            "bestTo" CHANGETO-> candidateTo
        "aiIndex" CHANGETO-> YO COMBINE aiIndex W/1
    HMM WATIF(bestFrom == -1)
        FINALANSER(0)
    SPITOUT("COSSERT ENGINE SCORE:")
    SPITOUT(bestScore)
    SPITOUT("AI FROM:")
    SPITOUT(bestFrom)
    SPITOUT("AI TO:")
    SPITOUT(bestTo)
    "moveFrom" CHANGETO-> bestFrom
    "moveTo" CHANGETO-> bestTo
    GET "doneAI" LETITB DOMOVE()
    FINALANSER(1)
}

SPITOUT("==============================================")
SPITOUT("          COSSERT CHESS ENGINE V0.1")
SPITOUT("==============================================")
SPITOUT("1 = HUMAN VS HUMAN")
SPITOUT("2 = HUMAN WHITE VS COSSERT AI BLACK")
SPITOUT("Example E2 to E4: FROM 52, TO 36")
GOAROUND 20 TIMES:
    YO USER DILE("Choose mode 1 or 2: "): gameMode
    HMM WATIF(gameMode == 1)
        FRGETABTIT
    HMM WATIF(gameMode == 2)
        FRGETABTIT
    SPITOUT("INVALID MODE.")
GET "showStart" LETITB SHOWBOARD()
"turn" CHANGETO-> "W"
"gameOver" CHANGETO-> 0
"plyCount" CHANGETO-> 0
GOAROUND 200 TIMES:
    HMM WATIF(gameOver == 1)
        FRGETABTIT
    HMM WATIF(turn == "W")
        SPITOUT("WHITE TO MOVE.")
        "moveSide" CHANGETO-> "W"
        GET "whiteMove" LETITB HUMANMOVE()
        "nextSide" CHANGETO-> "B"
    HMM WATIF(turn == "B")
        SPITOUT("BLACK TO MOVE.")
        "moveSide" CHANGETO-> "B"
        HMM WATIF(gameMode == 1)
            GET "blackMove" LETITB HUMANMOVE()
        HMM WATIF(gameMode == 2)
            GET "blackAIMove" LETITB AIMOVE()
        "nextSide" CHANGETO-> "W"
    "newPly" CHANGETO-> YO COMBINE plyCount W/1
    "plyCount" CHANGETO-> newPly
    GET "showAfter" LETITB SHOWBOARD()
    "moveSide" CHANGETO-> nextSide
    GET "responses" LETITB GENERATELEGAL()
    "checkSide" CHANGETO-> nextSide
    "isCheck" CHANGETO-> INCHECK()
    HMM WATIF(moveCount == 0)
        HMM WATIF(isCheck == 1)
            SPITOUT("CHECKMATE.")
            HMM WATIF(nextSide == "W")
                SPITOUT("BLACK WINS.")
            HMM WATIF(nextSide == "B")
                SPITOUT("WHITE WINS.")
            "gameOver" CHANGETO-> 1
        HMM WATIF(isCheck == 0)
            SPITOUT("STALEMATE. DRAW.")
            "gameOver" CHANGETO-> 1
    HMM WATIF(gameOver == 0)
        HMM WATIF(isCheck == 1)
            SPITOUT("CHECK!")
        "turn" CHANGETO-> nextSide
HMM WATIF(gameOver == 0)
    SPITOUT("200 PLY LIMIT REACHED.")
OKALFINEBYE
