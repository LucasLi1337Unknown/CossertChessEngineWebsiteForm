ELLO "INCHECK" YOUR NOW DOIN {
    "kingSq" CHANGETO-> -1
    "checkScan" CHANGETO-> 0
    GOAROUND 64 TIMES:
        "readIndex" CHANGETO-> checkScan
        "piece" CHANGETO-> READCELL()
        HMM WATIF(checkSide == "W")
            HMM WATIF(piece == "wK")
                "kingSq" CHANGETO-> checkScan
        HMM WATIF(checkSide == "B")
            HMM WATIF(piece == "bK")
                "kingSq" CHANGETO-> checkScan
        "checkScan" CHANGETO-> YO COMBINE checkScan W/1
    HMM WATIF(kingSq == -1)
        FINALANSER(1)
    "checkScan" CHANGETO-> 0
    GOAROUND 64 TIMES:
        "readIndex" CHANGETO-> checkScan
        "attackPiece" CHANGETO-> READCELL()
        HMM WATIF(checkSide == "W")
            HMM WATIF(attackPiece == "bP")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWP" LETITB ATTACKSKING()
                HMM WATIF(hitWP == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "bN")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWN" LETITB ATTACKSKING()
                HMM WATIF(hitWN == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "bB")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWB" LETITB ATTACKSKING()
                HMM WATIF(hitWB == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "bR")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWR" LETITB ATTACKSKING()
                HMM WATIF(hitWR == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "bQ")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWQ" LETITB ATTACKSKING()
                HMM WATIF(hitWQ == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "bK")
                "attackFrom" CHANGETO-> checkScan
                GET "hitWK" LETITB ATTACKSKING()
                HMM WATIF(hitWK == 1)
                    FINALANSER(1)
        HMM WATIF(checkSide == "B")
            HMM WATIF(attackPiece == "wP")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBP" LETITB ATTACKSKING()
                HMM WATIF(hitBP == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "wN")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBN" LETITB ATTACKSKING()
                HMM WATIF(hitBN == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "wB")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBB" LETITB ATTACKSKING()
                HMM WATIF(hitBB == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "wR")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBR" LETITB ATTACKSKING()
                HMM WATIF(hitBR == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "wQ")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBQ" LETITB ATTACKSKING()
                HMM WATIF(hitBQ == 1)
                    FINALANSER(1)
            HMM WATIF(attackPiece == "wK")
                "attackFrom" CHANGETO-> checkScan
                GET "hitBK" LETITB ATTACKSKING()
                HMM WATIF(hitBK == 1)
                    FINALANSER(1)
        "checkScan" CHANGETO-> YO COMBINE checkScan W/1
    FINALANSER(0)
}

ELLO "ADDLEGAL" YOUR NOW DOIN {
    HMM WATIF(moveTo < 0)
        FINALANSER(0)
    HMM WATIF(moveTo > 63)
        FINALANSER(0)
    "readIndex" CHANGETO-> moveTo
    "targetPiece" CHANGETO-> READCELL()
    GET "friendTarget" LETITB ISSAMECOLOR()
    HMM WATIF(friendTarget == 1)
        FINALANSER(0)
    HMM WATIF(targetPiece == "wK")
        FINALANSER(0)
    HMM WATIF(targetPiece == "bK")
        FINALANSER(0)
    GET "simLegal" LETITB SIMULATEMOVE()
    "checkSide" CHANGETO-> moveSide
    GET "leftInCheck" LETITB INCHECK()
    GET "undoLegal" LETITB UNDOMOVE()
    HMM WATIF(leftInCheck == 1)
        FINALANSER(0)
    GETDATIN{fromMoves} W/moveFrom
    GETDATIN{toMoves} W/moveTo
    "moveCount" CHANGETO-> YO COMBINE moveCount W/1
    FINALANSER(1)
}

ELLO "MOVESN" YOUR NOW DOIN {
    "raySq" CHANGETO-> moveFrom
    GOAROUND 7 TIMES:
        "mapIndex" CHANGETO-> raySq
        "moveTo" CHANGETO-> GETN()
        HMM WATIF(moveTo == -1)
            FRGETABTIT
        "readIndex" CHANGETO-> moveTo
        "targetPiece" CHANGETO-> READCELL()
        GET "sameRay" LETITB ISSAMECOLOR()
        HMM WATIF(sameRay == 1)
            FRGETABTIT
        GET "rayAdded" LETITB ADDLEGAL()
        HMM WATIF(NO{targetPiece == ""})
            FRGETABTIT
        "raySq" CHANGETO-> moveTo
    FINALANSER(0)
}

