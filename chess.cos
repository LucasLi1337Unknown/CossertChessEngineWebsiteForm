ELLO "GETROW" YOUR NOW DOIN {
    GET "rowGet" LETITB TAKITOUT{ROWMAP}[mapIndex]
    UREPLACEIT{ROWMAP}[mapIndex] W/rowGet
    FINALANSER(rowGet)
}

ELLO "READCELL" YOUR NOW DOIN {
    HMM WATIF(readIndex < 0)
        FINALANSER("")
    HMM WATIF(readIndex > 63)
        FINALANSER("")
    "readValue" CHANGETO-> TAKITOUT{board}[readIndex]
    UREPLACEIT{board}[readIndex] W/readValue
    FINALANSER(readValue)
}

ELLO "ISCURRENTPIECE" YOUR NOW DOIN {
    HMM WATIF(moveSide == "W")
        HMM WATIF(piece == "wP")
            FINALANSER(1)
        HMM WATIF(piece == "wN")
            FINALANSER(1)
        HMM WATIF(piece == "wB")
            FINALANSER(1)
        HMM WATIF(piece == "wR")
            FINALANSER(1)
        HMM WATIF(piece == "wQ")
            FINALANSER(1)
        HMM WATIF(piece == "wK")
            FINALANSER(1)
    HMM WATIF(moveSide == "B")
        HMM WATIF(piece == "bP")
            FINALANSER(1)
        HMM WATIF(piece == "bN")
            FINALANSER(1)
        HMM WATIF(piece == "bB")
            FINALANSER(1)
        HMM WATIF(piece == "bR")
            FINALANSER(1)
        HMM WATIF(piece == "bQ")
            FINALANSER(1)
        HMM WATIF(piece == "bK")
            FINALANSER(1)
    FINALANSER(0)
}

ELLO "ISSAMECOLOR" YOUR NOW DOIN {
    HMM WATIF(moveSide == "W")
        HMM WATIF(targetPiece == "wP")
            FINALANSER(1)
        HMM WATIF(targetPiece == "wN")
            FINALANSER(1)
        HMM WATIF(targetPiece == "wB")
