        GET "slidewQE" LETITB MOVESE()
        GET "slidewQW" LETITB MOVESW()
        GET "slidewQNE" LETITB MOVESNE()
        GET "slidewQNW" LETITB MOVESNW()
        GET "slidewQSE" LETITB MOVESSE()
        GET "slidewQSW" LETITB MOVESSW()
        FINALANSER(0)
    HMM WATIF(piece == "bQ")
        GET "slidebQN" LETITB MOVESN()
